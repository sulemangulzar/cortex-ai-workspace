# Database connection string. Use an async SQLAlchemy driver, for example:
# postgresql+asyncpg://user:password@host:5432/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cortex
FRONTEND_URL=http://localhost:5173

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Keep true in production. Set false only for local HTTP development.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# AI agent runtime
OPENAI_API_KEY=
CREWAI_MODEL=openai/gpt-4o-mini
CREWAI_ENABLED=true

# S3-compatible storage, for example Supabase Storage S3
SUPABASE_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
BUCKET_NAME=
MAX_UPLOAD_SIZE_BYTES=104857600
